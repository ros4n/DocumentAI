# Copy to .env and fill in your real values
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# sqlite by default; set DB_ENGINE=postgres + credentials below to use PostgreSQL
DB_ENGINE=sqlite
DB_NAME=snappy
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Form-field detection (Tier 1 VLM). OpenAI-compatible vision endpoint running
# PaddleOCR-VL or DeepSeek-OCR. Leave empty to skip Tier 1 (frontend uses its
# on-device OpenCV fallback automatically).
FIELD_DETECT_VLM_URL=
FIELD_DETECT_VLM_API_KEY=
FIELD_DETECT_VLM_MODEL=
